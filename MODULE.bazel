###############################################################################
# Bazel now uses Bzlmod by default to manage external dependencies.
# Please consider migrating your external dependencies from WORKSPACE to MODULE.bazel.
#
# For more details, please check https://github.com/bazelbuild/bazel/issues/18958
###############################################################################

module(name = "grpc_sandbox")

# SINGLE SOURCE OF TRUTH FOR VERSIONS
# When updating versions, update BOTH files to match:
# - MODULE.bazel (below)
# - buf.gen.yaml (protocolbuffers/cpp:v31.0 and grpc/cpp:v1.73.1)

# Protocol Buffers and gRPC
bazel_dep(name = "protobuf", version = "31.0")  # Must match buf.gen.yaml protocolbuffers/cpp:v31.0
bazel_dep(name = "grpc", version = "1.73.1")    # Must match buf.gen.yaml grpc/cpp:v1.73.1
bazel_dep(name = "rules_proto", version = "7.0.2")

# Go rules
bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.40.0")

# Configure Go SDK version
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.4")

# Python rules
bazel_dep(name = "rules_python", version = "1.0.0")

# Python interpreter and pip dependencies
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pip")

# C++ rules (usually included by default, but explicit is better)
bazel_dep(name = "rules_cc", version = "0.1.1")

# Go dependencies
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//src/go:go.mod")
use_repo(
    go_deps,
    "com_github_gofrs_uuid",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
)
