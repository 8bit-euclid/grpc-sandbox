load("@rules_python//python:defs.bzl", "py_library")

# Export generated Python files so they can be used by other packages
exports_files(glob([
    "*_pb2*.py",
]))

# Generated Python protobuf and gRPC library for {{SERVICE_NAME}}
# This file is regenerated when 'buf generate' runs
py_library(
    name = "{{SERVICE_NAME}}_py_proto",
    srcs = glob([
        "*_pb2*.py",
    ]) + ["__init__.py"],
    visibility = ["//visibility:public"],
    imports = [".."],
    deps = [
        "@pip//grpcio:pkg",
        "@pip//protobuf:pkg",
    ],
)
